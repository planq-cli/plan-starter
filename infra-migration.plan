{
  :id infra-migration-2026
  :version 1.0
  :title "2026 Infrastructure Migration"
  :description `
    Cross-team infrastructure migration: database, application, and network
    switch over in phases, then a shared acceptance gate. Schedule changes
    require owner sign-off.
  `
  :items [
    {
      :id discovery
      :task Discovery
      :items [
        {
          :id inventory
          :task "Asset inventory"
          :start 2026-02-02
          :end 2026-02-06
        }
        {
          :id dependency-map
          :task "Dependency mapping"
          :start 2026-02-09
          :end 2026-02-13
          :after [@inventory]
        }
        {
          :id discovery-done
          :milestone "Discovery complete"
          :date 2026-02-13
          :after [@dependency-map]
        }
      ]
    }
    {
      :id database
      :task "Database migration"
      :items [
        {
          :id db-prepare
          :task "Migration prep"
          :start 2026-02-16
          :end 2026-02-20
          :after [@discovery-done]
        }
        {
          :id db-review
          :task "Review migration plan"
          :deadline 2026-02-24
          :after [@db-prepare]
        }
        {
          :id db-dry-run
          :task "Migration dry run"
          :start 2026-02-25
          :end 2026-02-27
          :after [@db-review]
        }
        {
          :id db-migrate
          :task "Run the migration"
          :start 2026-03-02
          :end 2026-03-06
          :deadline 2026-03-09
          :after [@db-dry-run]
        }
        {
          :id db-done
          :milestone "Database migration complete"
          :date 2026-03-06
          :after [@db-migrate]
        }
      ]
    }
    {
      :id application
      :task "Application migration"
      // The pre-split rough schedule is kept inactive; the steps below roll up
      :start 2026-03-09
      :end 2026-03-28
      :deadline 2026-03-31
      :after [@database]
      :items [
        {
          :id app-config
          :task "Configuration changes"
          :start 2026-03-09
          :end 2026-03-13
          :after [@db-done]
        }
        {
          :id app-build
          :task "Build and image"
          :start 2026-03-16
          :end 2026-03-18
          :after [@app-config]
        }
        {
          :id app-canary
          :task "Canary release"
          :start 2026-03-19
          :end 2026-03-23
          :after [@app-build]
        }
        {
          :id app-rollout
          :task "Full rollout"
          :start 2026-03-24
          :end 2026-03-27
          :deadline 2026-03-31
          :after [@app-canary]
        }
        {
          :id app-done
          :milestone "Application migration complete"
          :date 2026-03-27
          :after [@app-rollout]
        }
      ]
    }
    {
      :id network
      :task "Network cutover"
      :items [
        {
          :id net-plan
          :task "Cutover plan"
          :start 2026-03-09
          :end 2026-03-11
          :after [@discovery-done]
        }
        {
          :id net-firewall
          :task "Firewall changes"
          :start 2026-03-12
          :end 2026-03-13
          :after [@net-plan]
        }
        {
          :id net-cutover
          :task "Execute cutover"
          :start 2026-03-30
          :end 2026-03-31
          :after [@net-firewall @app-done]
        }
        {
          :id net-done
          :milestone "Network cutover complete"
          :date 2026-03-31
          :after [@net-cutover]
        }
      ]
    }
    {
      :id acceptance
      :task Acceptance
      :items [
        {
          :id smoke-test
          :task "Smoke test"
          :start 2026-04-01
          :end 2026-04-02
          :after [@db-done @app-done @net-done]
        }
        {
          :id perf-test
          :task "Performance regression"
          :start 2026-04-03
          :end 2026-04-07
          :after [@smoke-test]
        }
        {
          :id signoff
          :task "Owner sign-off"
          :deadline 2026-04-10
          :after [@perf-test]
        }
        {
          :id project-done
          :milestone "Project accepted"
          :date 2026-04-10
          :after [@signoff]
        }
      ]
    }
    // Deferred work: not scheduled yet
    {
      :id followups
      :task Follow-ups
      :items [
        {
          :id cost-review
          :task "Cost review"
          :after [@project-done]
        }
        {
          :id doc-update
          :task "Runbook update"
        }
        {
          :id tooling-cleanup
          :task "Tooling cleanup"
        }
        {
          :id followups-done
          :milestone "Follow-ups complete"
          :after [@cost-review @doc-update]
        }
      ]
    }
  ]
}
